# Copy to <repo-root>/.env
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=chatsystem
POSTGRES_PORT=5432

# Must match the values above (Prisma reads this)
DATABASE_URL="postgresql://user:pass@localhost:5432/chatsystem"
CHAT_PORT=3000
GATEWAY_PORT=3001
VOICE_PORT=3002
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
JWT_SECRET=replace-with-a-long-random-secret
GATEWAY_PUBLIC_URL=ws://localhost:3001/gateway
