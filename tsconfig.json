{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ],
      "@app/config": [
        "./libs/config/src"
      ],
      "@app/config/*": [
        "./libs/config/src/*"
      ],
      "@app/database": [
        "./libs/database/src"
      ],
      "@app/database/*": [
        "./libs/database/src/*"
      ],
      "@app/kafka": [
        "./libs/kafka/src"
      ],
      "@app/kafka/*": [
        "./libs/kafka/src/*"
      ],
      "@app/redis": [
        "./libs/redis/src"
      ],
      "@app/redis/*": [
        "./libs/redis/src/*"
      ],
      "@app/scylla": [
        "./libs/scylla/src"
      ],
      "@app/scylla/*": [
        "./libs/scylla/src/*"
      ],
      "@app/snowflake": [
        "./libs/snowflake/src"
      ],
      "@app/snowflake/*": [
        "./libs/snowflake/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/chatsystem/tsconfig.app.json"
    },
    {
      "path": "./apps/gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/voice-signaling/tsconfig.app.json"
    }
  ]
}